rules_version = '2';

// ── The State CRM — security rules ──
// Goals: (1) only authenticated users touch data; (2) every document is strictly
// validated (exact field set, types, length/range caps, size cap) so bad/oversized
// writes are impossible; (3) writes are rate-limited per user so the demo cannot
// blow past Firebase's free-tier quotas or get stuck in a write loop. There are NO
// Cloud Functions (Blaze-only) — all enforcement lives here.
//
// Rate limit: every CRM mutation is committed in a batch that also writes
// usage/{uid} with lastWrite = request.time. cooldownOk() requires >= 400ms since
// the previous lastWrite, which structurally prevents runaway write loops.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function notTooBig() {
      return request.resource.size() < 16 * 1024;
    }

    // Per-user write cooldown enforced via the batched usage/{uid} ledger.
    function cooldownOk() {
      let path = /databases/$(database)/documents/usage/$(request.auth.uid);
      let prev = exists(path) ? get(path).data.lastWrite : request.time - duration.value(10, 's');
      return getAfter(path).data.lastWrite == request.time
        && request.time >= prev + duration.value(400, 'ms');
    }

    // The rate-limit ledger. Each user owns their own; must stamp lastWrite = now.
    match /usage/{u} {
      allow read: if signedIn() && u == request.auth.uid;
      allow write: if signedIn() && u == request.auth.uid
        && request.resource.data.lastWrite == request.time
        && request.resource.size() < 4 * 1024;
    }

    // Read-only config (e.g. a kill switch). No client writes.
    match /config/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── Validators (field allowlist + types + caps) ──
    function validCompany() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'industry', 'size', 'website', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.industry is string && d.industry.size() <= 80
        && d.size is string && d.size.size() <= 40
        && d.website is string && d.website.size() <= 200
        && d.createdAt is number;
    }

    function validContact() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'phone', 'title', 'companyId', 'tags', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.email is string && d.email.size() <= 160
        && d.phone is string && d.phone.size() <= 40
        && d.title is string && d.title.size() <= 100
        && d.companyId is string && d.companyId.size() <= 60
        && d.tags is list && d.tags.size() <= 12
        && d.createdAt is number;
    }

    function validDeal() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'value', 'stage', 'contactId', 'companyId', 'closeDate', 'createdAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 140
        && d.value is number && d.value >= 0 && d.value <= 1000000000
        && d.stage in ['lead', 'qualified', 'proposal', 'negotiation', 'won', 'lost']
        && d.contactId is string && d.contactId.size() <= 60
        && d.companyId is string && d.companyId.size() <= 60
        && d.closeDate is string && d.closeDate.size() <= 24
        && d.createdAt is number;
    }

    function validActivity() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'subject', 'due', 'done', 'dealId', 'contactId', 'createdAt'])
        && d.type in ['call', 'email', 'meeting', 'task']
        && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 200
        && d.due is string && d.due.size() <= 24
        && d.done is bool
        && d.dealId is string && d.dealId.size() <= 60
        && d.contactId is string && d.contactId.size() <= 60
        && d.createdAt is number;
    }

    match /companies/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && notTooBig() && validCompany() && cooldownOk();
      allow delete: if signedIn() && cooldownOk();
    }
    match /contacts/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && notTooBig() && validContact() && cooldownOk();
      allow delete: if signedIn() && cooldownOk();
    }
    match /deals/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && notTooBig() && validDeal() && cooldownOk();
      allow delete: if signedIn() && cooldownOk();
    }
    match /activities/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && notTooBig() && validActivity() && cooldownOk();
      allow delete: if signedIn() && cooldownOk();
    }

    // Deny everything else (incl. the retired student-app collections).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
